        <mxCell id="KToZm1H8G_EsGt0phmRX-5" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6d8764;fontColor=#ffffff;strokeColor=#3A5431;" value="&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(251, 251, 251));&quot;&gt;atributos(&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(251, 251, 251)); font-size: 11px;&quot;&gt;turno)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="115.5" width="105" x="675" y="790.25" as="geometry" />
        </mxCell>
        <mxCell id="KToZm1H8G_EsGt0phmRX-6" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6d8764;fontColor=#ffffff;strokeColor=#3A5431;" value="&lt;span style=&quot;font-size: 11px;&quot;&gt;&lt;u&gt;id_usuario(PK/FK)&lt;/u&gt;&lt;/span&gt;" vertex="1">
