@startuml

title Diagrama de Casos de Uso - Gimnasio APP

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle hollow

' --- DEFINICIÓN DE ACTORES ---
actor "Usuario\n(General)" as Usuario
actor "Socio" as Socio
actor "Entrenador" as Entrenador
actor "Secretario\n(Administración)" as Secretario

' Herencia de actores: Socio, Entrenador y Secretario son tipos de Usuario
Socio -up-|> Usuario
Entrenador -up-|> Usuario
Secretario -up-|> Usuario

' --- SISTEMA Y CASOS DE USO ---
package "Sistema Gimnasio APP" {
    
    ' Casos de uso generales
    usecase "Iniciar Sesión" as UC_Login
    usecase "Cerrar Sesión" as UC_Logout
    
    ' Casos de uso de Socio
    usecase "Reservar Sesión/Clase" as UC_Reservar
    usecase "Consultar Suscripción Activa" as UC_VerSuscripcion
    
    ' Casos de uso de Entrenador
    usecase "Consultar Horario de Clases" as UC_VerHorario
    usecase "Ver Lista de Asistentes" as UC_VerAsistentes
    
    ' Casos de uso de Secretario (Las novedades)
    usecase "Gestionar Socios\n(Altas, Bajas, Modificaciones)" as UC_GestSocio
    usecase "Gestionar Entrenadores\n(Altas, Bajas, Especialidades)" as UC_GestEntrenador
    usecase "Administrar Planes de Precios\n(Crear, Editar Tarifas)" as UC_GestPlanes
    usecase "Gestionar Copias de Seguridad\n(JSON)" as UC_Backup
}

' --- RELACIONES ---

' Todos los usuarios pueden loguearse
Usuario --> UC_Login
Usuario --> UC_Logout

' Acciones específicas del Socio
Socio --> UC_Reservar
Socio --> UC_VerSuscripcion

' Acciones específicas del Entrenador
Entrenador --> UC_VerHorario
Entrenador --> UC_VerAsistentes

' Acciones específicas del Secretario (Administración total)
Secretario --> UC_GestSocio
Secretario --> UC_GestEntrenador
Secretario --> UC_GestPlanes
Secretario --> UC_Backup

@enduml