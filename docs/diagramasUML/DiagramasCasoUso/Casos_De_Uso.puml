@startuml
left to right direction

' 1. Definición de los actores principales (Aparecerán a la izquierda)
actor "Usuario (Superclase)" as usuario
actor "Socio" as socio
actor "Entrenador" as entrenador
actor "Secretario" as secretario

' 2. Jerarquía de herencia (Lado izquierdo)
usuario <|-- socio  
usuario <|-- entrenador
usuario <|-- secretario

rectangle "Sistema Gimnasio APP" {
  
  ' Funciones Generales
  usecase "Iniciar Sesión" as UC1
  usecase "Cerrar Sesión" as UC2
  
  ' Funciones de Cliente (Socio)
  usecase "Mis Reservas (En const.)" as UC3
  
  ' Funciones de Entrenador
  usecase "Ver mi horario de clases" as UC4
  usecase "Ver Listado de Socios (Lectura)" as UC5
  
  ' Funciones de Operaciones (Secretario y Admin)
  usecase "Gestionar Socios (Altas/Bajas)" as UC6
  usecase "Gestionar Entrenadores" as UC7
  usecase "Gestionar Planes y Suscripciones" as UC8
  usecase "Gestionar Sesiones y Reservas" as UC9
  
  ' Funciones Exclusivas de Administración (Admin)
  usecase "Gestionar Secretarios" as UC10
  usecase "Borrado Permanente de Registros" as UC11
  usecase "Herramientas de Sistema (Backup/Reset)" as UC12
}

' 3. Definición del Administrador (Para que aparezca a la derecha)
actor "Administrador (Admin)" as admin

' --- RELACIONES ---

' Relaciones del Usuario (Heredadas por el resto)
usuario --> UC1
usuario --> UC2

' Relaciones del Socio
socio --> UC3

' Relaciones del Entrenador
entrenador --> UC4
entrenador --> UC5

' Relaciones del Secretario
secretario --> UC6
secretario --> UC7
secretario --> UC8
secretario --> UC9

' Relaciones del Administrador (Aparecerá a la derecha)
' Usamos <-- para forzar que el actor se dibuje en el lado derecho del rectángulo
UC1 <-- admin
UC2 <-- admin
UC6 <-- admin
UC7 <-- admin
UC8 <-- admin
UC9 <-- admin
UC10 <-- admin
UC11 <-- admin
UC12 <-- admin

@enduml