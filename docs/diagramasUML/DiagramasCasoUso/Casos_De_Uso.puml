@startuml
left to right direction

' 1. Definición de los actores
actor "Usuario (Superclase)" as usuario
actor "Socio" as socio
actor "Entrenador" as entrenador
actor "Secretario (Admin)" as secretario

' 2. Jerarquía de herencia: Todos heredan las funciones base de Usuario
usuario <|-- socio  

usuario <|-- entrenador

usuario <|-- secretario

rectangle "Sistema Gimnasio APP" {
  
  ' Funciones Generales
  usecase "Iniciar Sesión" as UC1
  usecase "Cerrar Sesión" as UC2
  
  ' Funciones de Cliente (Socio)
  usecase "Contratar Plan/Suscripción" as UC3
  usecase "Consultar Suscripción Activa" as UC4
  usecase "Reservar Sesión/Clase" as UC5
  
  ' Funciones de Operaciones (Entrenador y Secretario)
  usecase "Consultar Horario de Clases" as UC6
  usecase "Ver Lista de Asistentes" as UC7
  usecase "Crear Sesión" as UC8
  
  ' Funciones de Administración (Secretario)
  usecase "Gestionar Socios (Altas/Bajas)" as UC9
  usecase "Gestionar Entrenadores" as UC10
  usecase "Administrar Planes de Precios" as UC11
  usecase "Gestionar Copias de Seguridad" as UC12
}

' --- RELACIONES ---

' Relaciones del Usuario (Heredadas por el resto)
usuario --> UC1
usuario --> UC2

' Relaciones del Socio
socio --> UC3
socio --> UC4
socio --> UC5

' Relaciones del Entrenador
entrenador --> UC6
entrenador --> UC7
entrenador --> UC8

' Relaciones del Secretario
' Como es el administrador, necesita ver horarios y asistentes para gestionar, 
' además de sus funciones exclusivas de CRUD.
secretario --> UC6
secretario --> UC7
secretario --> UC9
secretario --> UC10
secretario --> UC11
secretario --> UC12

@enduml