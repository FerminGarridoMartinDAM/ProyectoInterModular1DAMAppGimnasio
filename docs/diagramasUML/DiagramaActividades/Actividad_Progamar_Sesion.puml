@startuml
title Proceso de Programar Sesión

start

:Acceder a "Calendario de Sesiones";
:Seleccionar "Programar nueva sesión";
:Solicitar ID de la Clase;

if (¿Usuario es Entrenador?) then (Sí)
  :Asignar su propio ID automáticamente;
else (No)
  :Solicitar ID del Entrenador que dará la clase;
endif

:Seleccionar Sala de la Lista;
:Introducir Fecha/Hora Inicio y Fin;

if (¿Fecha Fin es anterior a Fecha Inicio?) then (Sí)
  :Mostrar "Error de lógica temporal"; <<#red>>
else (No)
  :Registrar Sesión en Base de Datos;
  :Mostrar "Sesión programada con éxito"; <<#green>>
endif

stop
@enduml