@startuml

title Proceso de Reserva de Sesión

start

:Acceder a "Gestión de Reservas";
:Seleccionar "Registrar nueva reserva";

:Solicitar ID de Socio;
if (¿El Socio existe?) then (No)
  :Mostrar error y cancelar; <<#red>>
  stop
else (Sí)
endif

:Solicitar ID de Sesión;
if (¿La Sesión existe?) then (No)
  :Mostrar error y cancelar; <<#red>>
  stop
else (Sí)
endif

:Insertar Reserva en BD;

if (¿La Clave Compuesta ya existe?) then (Sí)
  :La BD rechaza el registro;
  :Mostrar "El socio ya tiene reserva para esta sesión"; <<#red>>
else (No)
  :Mostrar "Reserva confirmada"; <<#green>>
endif

stop

@enduml