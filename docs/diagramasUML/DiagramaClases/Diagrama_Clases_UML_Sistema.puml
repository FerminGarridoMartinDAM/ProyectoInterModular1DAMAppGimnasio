@startuml

title Diagrama de Clases de Implementación (Arquitectura Completa y Actualizada)

' --- CAPA DE UTILIDADES Y CONEXIÓN ---
package "database" {
    class database.ConexionDB {
        + getConexion(): Connection
    }
    
    note bottom of ConexionDB
      **Nota de Arquitectura:**
       Solo he puesto una conexion representativa aqui,
      para no llenar de lineas.
      PERO.
      Todas las implementaciones 
      DAOPostgresImpl de este sistema 
      dependen de ConexionDB para 
      ejecutar sus consultas.
    end note
}

package "utils" {
    class utils.Main {
        + main(args: String[])
    }
}

' --- CAPA DE MODELO (Datos y Lógica de Negocio) ---
package "model" {
    abstract class model.Usuario {
        - idUsuario: int
        - nombre: String
        - apellido: String
        - email: String
        - password: String
        - telefono: String
    }

    class model.Socio {
        - fechaAlta: LocalDate
    }

    class model.Entrenador {
        - especialidad: String
    }

    class model.Secretario {
        - turno: String
    }

    class model.Clase {
        - idClase: int
        - nombre: String
        - aforoMax: int
    }

    class model.Plan {
        - idPlan: int
        - nombre: String
        - precio: double
    }

    class model.Sesion {
        - idSesion: int
        - inicio: LocalDateTime
        - fin: LocalDateTime
        - sala: String
    }

    class model.Suscripcion {
        - idSuscripcion: int
        - fechaFin: LocalDate
    }

    class model.Reserva {
        - idReserva: int
        - fechaReserva: LocalDateTime
    }
    
    ' Herencia
    model.Usuario <|-- model.Socio
    model.Usuario <|-- model.Entrenador
    model.Usuario <|-- model.Secretario
}

' --- CAPA DE DATOS (DAOs) ---
package "dao" {
    interface dao.SocioDAO
    class dao.SocioDAOPostgresImpl
    dao.SocioDAO <|.. dao.SocioDAOPostgresImpl

    interface dao.EntrenadorDAO
    class dao.EntrenadorDAOPostgresImpl
    dao.EntrenadorDAO <|.. dao.EntrenadorDAOPostgresImpl

    interface dao.SecretarioDAO
    class dao.SecretarioDAOPostgresImpl
    dao.SecretarioDAO <|.. dao.SecretarioDAOPostgresImpl

    interface dao.ClaseDAO
    class dao.ClaseDAOPostgresImpl
    dao.ClaseDAO <|.. dao.ClaseDAOPostgresImpl

    interface dao.PlanDAO
    class dao.PlanDAOPostgresImpl
    dao.PlanDAO <|.. dao.PlanDAOPostgresImpl

    interface dao.SesionDAO
    class dao.SesionDAOPostgresImpl
    dao.SesionDAO <|.. dao.SesionDAOPostgresImpl

    interface dao.ReservaDAO
    class dao.ReservaDAOPostgresImpl
    dao.ReservaDAO <|.. dao.ReservaDAOPostgresImpl

    interface dao.SuscripcionDAO
    class dao.SuscripcionDAOPostgresImpl
    dao.SuscripcionDAO <|.. dao.SuscripcionDAOPostgresImpl
    
    ' Dependencia de la Base de Datos
    dao.SocioDAOPostgresImpl ..> database.ConexionDB : usa >
    dao.EntrenadorDAOPostgresImpl ..> database.ConexionDB : usa >
    dao.SecretarioDAOPostgresImpl ..> database.ConexionDB : usa >
    dao.ClaseDAOPostgresImpl ..> database.ConexionDB : usa >
    dao.PlanDAOPostgresImpl ..> database.ConexionDB : usa >
    dao.SesionDAOPostgresImpl ..> database.ConexionDB : usa >
    dao.ReservaDAOPostgresImpl ..> database.ConexionDB : usa >
    dao.SuscripcionDAOPostgresImpl ..> database.ConexionDB : usa >
}

' --- CAPA DE CONTROL (Menús) ---
package "controller" {
    class controller.MenuController {
    }
    
    class controller.SocioMenu {
    }
    
    class controller.EntrenadorMenu {
    }
    
    class controller.SecretarioMenu {
    }

    class controller.ClaseMenu {
    }
    
    class controller.PlanMenu {
    }
    
    class controller.SesionMenu {
    }
    
    class controller.SuscripcionMenu {
    }
    
    class controller.PeligroMenu {
    }
    
    controller.MenuController --> controller.SocioMenu
    controller.MenuController --> controller.EntrenadorMenu
    controller.MenuController --> controller.SecretarioMenu
    controller.MenuController --> controller.ClaseMenu
    controller.MenuController --> controller.PlanMenu
    controller.MenuController --> controller.SesionMenu
    controller.MenuController --> controller.SuscripcionMenu
    controller.MenuController --> controller.PeligroMenu
}

' --- CONEXIONES ENTRE CAPAS (Ejemplo representativo) ---
utils.Main --> controller.MenuController : inicia >
controller.SocioMenu ..> dao.SocioDAO : usa >
dao.SocioDAOPostgresImpl ..> model.Socio : crea/mapea >
dao.SecretarioDAOPostgresImpl ..> model.Secretario : crea/mapea >

@enduml