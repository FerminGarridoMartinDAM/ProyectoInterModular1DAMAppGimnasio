@startuml
title Diagrama de Secuencia: Gestionar Suscripción - Gym APP

autonumber

' --- PARTICIPANTES ---
actor "Socio" as User
boundary "MenuSuscripcion" as Vista
control "SuscripcionController" as Controller
participant "SuscripcionDAO" as SuscDAO
participant "PlanDAO" as PlanDAO
database "Supabase\n(PostgreSQL)" as DB

' --- FLUJO DE EJECUCIÓN ---
User -> Vista: Selecciona "Mi Suscripción"
activate Vista

Vista -> Controller: consultarEstado(idSocio)
activate Controller

' 1. Comprobar si ya tiene suscripción
Controller -> SuscDAO: obtenerSuscripcionActiva(idSocio)
activate SuscDAO

SuscDAO -> DB: SELECT * FROM suscripcion WHERE id_socio = ?
activate DB
DB --> SuscDAO: Devuelve suscripción (o nulo)
deactivate DB

SuscDAO --> Controller: retorna Objeto Suscripcion
deactivate SuscDAO

' 2. Bifurcación Lógica
alt Tiene suscripción activa
    Controller -[#green]-> Vista: <color:green>retorna datos de la Suscripción</color>
    Vista --> User: Muestra detalles (Plan, Fecha fin, Estado)
    
else No tiene suscripción
    ' El sistema busca los planes disponibles para ofrecérselos
    Controller -> PlanDAO: obtenerPlanesActivos()
    activate PlanDAO
    
    PlanDAO -> DB: SELECT * FROM plan
    activate DB
    DB --> PlanDAO: Devuelve lista de planes
    deactivate DB
    
    PlanDAO --> Controller: retorna Lista<Plan>
    deactivate PlanDAO
    
    Controller -[#green]-> Vista: <color:green>retorna Lista de Planes disponibles</color>
    Vista --> User: Muestra catálogo de Planes
    
    ' El socio decide comprar
    User -> Vista: Elige un Plan y pulsa "Contratar"
    Vista -> Controller: contratarPlan(idSocio, idPlan)
    
    ' Se guarda la nueva suscripción
    Controller -> SuscDAO: registrarNuevaSuscripcion(idSocio, idPlan)
    activate SuscDAO
    
    SuscDAO -> DB: INSERT INTO suscripcion (...)
    activate DB
    DB --> SuscDAO: Confirmación (1 fila afectada)
    deactivate DB
    
    SuscDAO --> Controller: true (Éxito)
    deactivate SuscDAO
    
    Controller -[#green]-> Vista: <color:green>Confirmación: Plan contratado con éxito</color>
    Vista --> User: Muestra "¡Suscripción activada!"
end

deactivate Controller
deactivate Vista

@enduml