@startuml

skinparam maxMessageSize 100

actor "Administrador" as admin
boundary "Panel\nFinanciero" as vista
control "Controlador\nAdmin" as controlador
entity "SocioDAO" as dao
database "Supabase" as db

' Inicio del proceso
admin -> vista : 1. Solicita "Resumen de Ingresos"
activate vista

vista -> controlador : 2. obtenerTotalIngresos()
activate controlador

' El controlador pide al DAO que haga el cálculo
controlador -> dao : 3. calcularSumaCuotas()
activate dao

' La base de datos hace el trabajo pesado (SUM)
dao -> db : 4. SELECT SUM(precio_plan) FROM socio_plan
activate db
db --> dao : 5. Retorna valor total (ej: 5250)
deactivate db

dao --> controlador : 6. Retorna double total
deactivate dao

' Lógica de negocio: Formatear el resultado
controlador -> controlador : 7. formatearMoneda(total)

' Devolución de la información
controlador --> vista : 8. enviarDatosInforme(informeFormateado)
vista --> admin : 9. Muestra Gráfico e Ingresos Totales

deactivate controlador
deactivate vista
@enduml