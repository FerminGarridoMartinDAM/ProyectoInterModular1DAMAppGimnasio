@startuml
title Diagrama de Secuencia: Programar Nueva Sesión - Gym APP

autonumber

' --- PARTICIPANTES ---
actor "Entrenador" as User
boundary "MenuProgramacion" as Vista
control "ProgramacionController" as Controller
participant "ClaseDAO" as ClaseDAO
participant "SesionDAO" as SesionDAO
database "Supabase\n(PostgreSQL)" as DB

' --- FLUJO 1: Mostrar catálogo de clases ---
User -> Vista: Selecciona "Programar Nueva Sesión"
activate Vista

Vista -> Controller: obtenerClasesDisponibles()
activate Controller

Controller -> ClaseDAO: listar()
activate ClaseDAO
ClaseDAO -> DB: SELECT * FROM clase
activate DB
DB --> ClaseDAO: Devuelve catálogo de disciplinas
deactivate DB
ClaseDAO --> Controller: retorna Lista<Clase>
deactivate ClaseDAO

Controller -[#green]-> Vista: <color:green>retorna Lista de Clases</color>
deactivate Controller

Vista --> User: Muestra opciones (Yoga, CrossFit, etc.)

' --- FLUJO 2: Proceso de creación ---
User -> Vista: Introduce datos (idClase, inicio, fin, sala)
Vista -> Controller: programarSesion(idEntrenador, idClase, inicio, fin, sala)
activate Controller

' Validación de conflictos
Controller -> SesionDAO: verificarConflictos(sala, inicio)
activate SesionDAO
SesionDAO -> DB: SELECT count(*) FROM sesion WHERE sala = ? AND inicio = ?
activate DB
DB --> SesionDAO: Resultado (0 o 1)
deactivate DB
SesionDAO --> Controller: hay_conflicto (boolean)
deactivate SesionDAO

alt Conflicto de horario o sala
    Controller -[#red]-> Vista: <color:red>retorna error_conflicto</color>
    Vista --> User: Muestra "La sala ya está ocupada en ese horario"
    
else Todo libre (Sin conflictos)
    ' Inserción final de la sesión
    Controller -> SesionDAO: insertar(nuevaSesion)
    activate SesionDAO
    SesionDAO -> DB: INSERT INTO sesion (...)
    activate DB
    DB --> SesionDAO: Confirmación (éxito)
    deactivate DB
    SesionDAO --> Controller: true
    deactivate SesionDAO
    
    Controller -[#green]-> Vista: <color:green>Confirmación: Sesión programada con éxito</color>
    Vista --> User: Mensaje "Clase añadida al calendario"
end

deactivate Controller
deactivate Vista

@enduml