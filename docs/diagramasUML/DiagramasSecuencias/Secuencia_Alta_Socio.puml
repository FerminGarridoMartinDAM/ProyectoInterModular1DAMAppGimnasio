@startuml

' Definición de los participantes
actor "Gestor" as gestor
boundary "Pantalla\nAlta Socio" as vista
control "Controlador\nSocio" as controlador
entity "Seguridad\n(BCrypt)" as hash
entity "SocioDAO" as dao
database "Supabase" as db

' El proceso empieza
gestor -> vista : 1. Rellena datos (nombre, email, password...) y pulsa "Guardar"
activate vista

vista -> controlador : 2. registrarSocio(datos)
activate controlador

' 1ª Validación: ¿El email ya existe?
controlador -> dao : 3. buscarPorEmail(email)
activate dao
dao -> db : 4. SELECT * FROM socio WHERE email = X
activate db
db --> dao : 5. Retorna resultado (nulo o socio)
deactivate db
dao --> controlador : 6. Retorna resultado
deactivate dao

alt Si el email YA existe
    controlador --> vista : 7. mostrarError("El email ya está registrado")
    vista --> gestor : 8. Muestra alerta de error
else Si el email NO existe (Vía libre)

    ' 2ª Acción Crítica: Encriptar Contraseña
    controlador -> hash : 9. encriptar(password)
    activate hash
    hash --> controlador : 10. Retorna password_encriptada (ej: $2a$10$...)
    deactivate hash
    
    ' 3ª Acción: Guardar en Base de Datos
    controlador -> dao : 11. insertarSocio(datos_con_pass_encriptada)
    activate dao
    
    dao -> db : 12. INSERT INTO socio (...)
    activate db
    db --> dao : 13. Confirmación (OK)
    deactivate db
    
    dao --> controlador : 14. Retorna true (Éxito)
    deactivate dao
    
    controlador --> vista : 15. mostrarMensaje("Socio registrado con éxito")
    vista --> gestor : 16. Muestra confirmación
end

deactivate controlador
deactivate vista
@enduml